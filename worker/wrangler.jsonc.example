{
  // Copy to wrangler.jsonc and fill in YOUR values:
  //   cp wrangler.jsonc.example wrangler.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "share",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-06",
  "observability": {
    "enabled": true
  },
  "vars": {
    // Artifact expiration window, in days.
    "EXPIRY_DAYS": "15",
    // Maximum size per artifact, in MB.
    "MAX_UPLOAD_MB": "2"
    // PUBLIC_BASE_URL is OPTIONAL. If omitted, links are derived from the
    // incoming request host — so the free workers.dev URL just works, no config.
    // Set it only to force a canonical URL (e.g. a custom domain):
    // "PUBLIC_BASE_URL": "https://share.your-domain.com"
  },
  // The free Cloudflare URL: <worker>.<your-subdomain>.workers.dev. No domain needed.
  "workers_dev": true,
  // Custom domain — OPTIONAL, and only if you own a domain whose zone is in your
  // Cloudflare account. Most users can skip this and use the workers.dev URL above.
  // Uncomment and replace with your domain:
  // "routes": [
  //   { "pattern": "share.your-domain.com", "custom_domain": true }
  // ],
  // Create the KV and paste the id: `wrangler kv namespace create DOCS`
  "kv_namespaces": [
    {
      "binding": "DOCS",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ]
  // Set the secret (it does not go into the file):
  //   echo "$(openssl rand -hex 32)" | wrangler secret put SESSION_SECRET
}
